{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",

      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",

      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",

      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pytest *)",
      "Bash(alembic *)",

      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(docker compose restart*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(pm2 *)",
      "Bash(nginx *)",
      "Bash(certbot *)",
      "Bash(postfix *)",
      "Bash(dovecot *)",
      "Bash(opendkim *)",
      "Bash(git push*)",
      "Bash(rm *)",
      "Bash(docker compose down*)",
      "Bash(docker system *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume *)",
      "Bash(psql *)",
      "Bash(mysql *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./private/**)",
      "Read(./keys/**)",
      "Read(/root/.ssh/**)",
      "Read(/root/.claude/.credentials.json)",
      "Read(/etc/letsencrypt/**)",
      "Read(/etc/postfix/**)",
      "Read(/etc/dovecot/**)",
      "Read(/etc/opendkim/**)"
    ]
  }
}
