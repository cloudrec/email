{
  "name": "email-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "test": "vitest run",
