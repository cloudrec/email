# Email Platform - environment template
# Copy to .env and fill in real secrets. NEVER commit .env.

# ---------- Platform ----------
PLATFORM_DOMAIN=email.clients.help
PLATFORM_NAME=Email Platform
PLATFORM_ENV=production
PLATFORM_DEFAULT_LOCALE=en
PLATFORM_TIMEZONE=UTC

# ---------- Reverse proxy ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# ---------- Portal (Next.js) ----------
PORTAL_PORT=3000
PORTAL_PUBLIC_URL=https://email.clients.help
PORTAL_INTERNAL_API_URL=http://api:4000

# ---------- API (Node) ----------
API_PORT=4000
# Must be a long random string (>=24 chars). The API refuses to boot if this is
# left as the placeholder or too short (auth tokens would be forgeable).
# Generate: openssl rand -hex 32
API_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
API_JWT_TTL=86400
API_REFRESH_TTL=2592000
# Dead: password hashing uses argon2, not bcrypt. Kept for backward compat only.
API_BCRYPT_ROUNDS=12
API_RATE_LIMIT_AUTH_PER_MIN=10
API_RATE_LIMIT_GENERAL_PER_MIN=120
# At-rest key for the mailbox secrets vault (SMTP/IMAP creds). Defaults to
# API_JWT_SECRET if unset. Generate a dedicated one: openssl rand -hex 32
SECRETS_MASTER_KEY=
LOG_LEVEL=info

# ---------- Seed / tenant bootstrap (CLI: make seed / create-tenant) ----------
# Required by `make seed` — seeding aborts without SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL=admin@email.clients.help
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_TENANT_PASSWORD=CHANGE_ME_TENANT_PASSWORD

# ---------- Database (MariaDB) ----------
DB_HOST=db
DB_PORT=3306
DB_NAME=email_platform
DB_USER=email_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- Worker ----------
WORKER_CONCURRENCY=4
WORKER_SEND_RATE_PER_SEC=20

# ---------- SMTP / Postal (default sender for system mail) ----------
SMTP_HOST=postal
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@email.clients.help
SMTP_FROM_NAME=Email Platform

# ---------- Tracking ----------
TRACKING_DEFAULT_DOMAIN=track.email.clients.help
TRACKING_PIXEL_PATH=/o
TRACKING_CLICK_PATH=/c
TRACKING_UNSUB_PATH=/u

# ---------- Search providers (Collector Mode) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Multiple keys for rotation: comma list, or numbered TAVILY_API_KEY_1..32
TAVILY_API_KEYS=
TAVILY_MAX_RESULTS_PER_QUERY=20
TAVILY_DAILY_CREDIT_LIMIT=100
TAVILY_MONTHLY_CREDIT_LIMIT=1000
TAVILY_TIMEOUT_MS=15000
# Set to 1 to return stubbed search results instead of calling a provider (dev).
STUB_SEARCH_RESULTS=

# ---------- OSM / Overpass (perpetual collector geo lookups) ----------
OVERPASS_ENDPOINT=
OVERPASS_TIMEOUT_MS=30000
OVERPASS_UA=email-platform-collector

# ---------- Zoho manual bridge (send/reply) — optional ----------
# The Zoho bridge silently no-ops unless these are set.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=587
ZOHO_IMAP_HOST=imap.zoho.eu
ZOHO_IMAP_PORT=993
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=

# ---------- SEO blog publisher — optional ----------
SEO_PUBLISH_TOKEN=

# ---------- SMTP node / infra hints — optional ----------
SERVER_PUBLIC_IP=
IMPORT_BATCH_CAP=5000

# ---------- Webhooks ----------
# Required for POST /webhooks/bounce. Generate: openssl rand -hex 32.
WEBHOOK_BOUNCE_SECRET=CHANGE_ME_BOUNCE_WEBHOOK_SECRET

# ---------- Billing adapter ----------
BILLING_DEFAULT_PROVIDER=manual
BILLING_CURRENCIES=USD,EUR,USDT
BILLING_TRIAL_DAYS=14

# ---------- Backups ----------
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPT_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---------- Optional services (profile-gated) ----------
# Enable with: docker compose --profile analytics up -d
CLICKHOUSE_ENABLED=false
GRAFANA_ENABLED=false
PROMETHEUS_ENABLED=false
# Grafana admin password (profile: monitoring). Defaults to insecure admin/admin.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
